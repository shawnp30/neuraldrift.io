# ─── Supabase ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
# Legacy/other Supabase features may still read this. The broadcast publisher
# no longer requires it (see NEURALDRIFT_SUPABASE_SECRET_KEY below).
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ─── Site ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://neuraldrift

# ─── ComputeAtlas (Affiliate Partner) ────────────────────────────────────────
COMPUTEATLAS_API_KEY=your_computeatlas_api_key
COMPUTEATLAS_WEBHOOK_SECRET=your_computeatlas_webhook_secret
NEXT_PUBLIC_COMPUTEATLAS_AFFILIATE_ID=your_affiliate_id

# ─── Stripe ──────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ─── Analytics ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_POSTHOG_KEY=phc_...
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# ─── Newsletter (Kit) ─────────────────────────────────────────────────────────
# The public provider switch enables the branded NeuralDrift form. It is not a secret.
NEXT_PUBLIC_NEWSLETTER_PROVIDER=kit
# Server-only Kit V4 API key. Never prefix with NEXT_PUBLIC_ and never commit a real key.
KIT_API_KEY=
# Numeric Kit form ID for NeuralDrift Weekly (9914909). The form UID is reference-only.
KIT_FORM_ID=9914909
# Internal-only secret protecting the broadcast publisher. Never expose via NEXT_PUBLIC_.
NEURALDRIFT_PUBLISHER_SECRET=
# Server-only, manually managed Supabase credential used for the broadcast
# publisher's idempotency ledger (a modern "sb_secret_..." secret key, or a
# legacy service_role JWT). Never prefix with NEXT_PUBLIC_ and never commit a
# real value. This replaces the orphaned/integration-owned
# SUPABASE_SERVICE_ROLE_KEY for the broadcast publisher.
NEURALDRIFT_SUPABASE_SECRET_KEY=
# Optional: only set this if the broadcast publisher's Supabase project
# differs from NEXT_PUBLIC_SUPABASE_URL above. When unset, NEXT_PUBLIC_SUPABASE_URL is reused.
NEURALDRIFT_SUPABASE_URL=

# ─── Vercel Blob ─────────────────────────────────────────────────────────────
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# ─── Email (Resend) ──────────────────────────────────────────────────────────
RESEND_API_KEY=re_...

# ─── Amazon Affiliate ────────────────────────────────────────────────────────
NEXT_PUBLIC_AMAZON_AFFILIATE_TAG=neuraldrift-20
